# Flask Environment
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Cryptographically Secure Secret Key (64-character hex)
SECRET_KEY=9d4e5f2a1b7c8d0e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e

# Session Security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=30

# Database Configuration
DATABASE_PATH=instance/secure_auth.sqlite3

# Rate Limiting & Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
IP_RATE_LIMIT_WINDOW_SECONDS=300
IP_RATE_LIMIT_MAX_REQUESTS=20

# Password Reset Token Expiry
RESET_TOKEN_EXPIRY_MINUTES=15

# Development Mailbox Simulator (Simulates email delivery directly in the UI and terminal)
DEV_EMAIL_SIMULATOR=true
