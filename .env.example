# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security Secrets (Generate a 64-char hex string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_64_characters_minimum

# Session Security
# Set to 'true' in production behind HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=30

# Database Configuration
DATABASE_PATH=instance/secure_auth.sqlite3

# Rate Limiting & Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
IP_RATE_LIMIT_WINDOW_SECONDS=300
IP_RATE_LIMIT_MAX_REQUESTS=20

# Password Reset Token
RESET_TOKEN_EXPIRY_MINUTES=15

# Development Mailbox Simulator
# When true, reset links are displayed on terminal and in a local dev notification
DEV_EMAIL_SIMULATOR=true
